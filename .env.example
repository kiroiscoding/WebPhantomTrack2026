# Shopify (Headless sales channel → Storefront API)
# Your store's myshopify domain, e.g. phantom-track.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Headless channel → Storefront API → "Public access token"
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Optional: Storefront API version (defaults to 2026-07)
# SHOPIFY_STOREFRONT_API_VERSION=2026-07
