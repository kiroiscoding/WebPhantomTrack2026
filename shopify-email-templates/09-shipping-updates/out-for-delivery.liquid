{%- comment -%}
  Phantom Track — Out for delivery
  Generated by shopify-email-templates/build.py. Edit there, not here.
{%- endcomment -%}
{%- assign site_url = 'https://phantom-track.com' -%}
{%- assign support_email = 'contact@phantom-track.com' -%}
{%- assign accent = '#a855f7' -%}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <meta name="supported-color-schemes" content="dark">
  <title>Order {{ order_name }} is out for delivery</title>
  <style>
    body { margin: 0; padding: 0; background: #050505; }
    a { color: #a855f7; }
    @media only screen and (max-width: 620px) {
      .container { width: 100% !important; }
      .px { padding-left: 20px !important; padding-right: 20px !important; }
      .stack { display: block !important; width: 100% !important; padding: 0 0 20px 0 !important; }
      .hero { font-size: 40px !important; }
    }
  </style>
</head>
<body style="margin:0; padding:0; background:#050505; -webkit-text-size-adjust:100%;">

  <div style="display:none; max-height:0; overflow:hidden; opacity:0; color:#050505;">
    Your Phantom Track order {{ order_name }} arrives today.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#050505" style="background:#050505;">
    <tr>
      <td align="center" style="padding: 32px 12px;">
        <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px; max-width:600px;">

          <!-- Header -->
          <tr>
            <td class="px" style="padding: 0 32px 28px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="left" valign="middle">
                    <a href="{{ site_url }}" style="text-decoration:none;">
                      {%- if shop.email_logo_url -%}
                        <img src="{{ shop.email_logo_url }}" alt="Phantom Track" width="{{ shop.email_logo_width | default: 160 }}" style="display:block; border:0; max-width:220px; height:auto;">
                      {%- else -%}
                        <span style="font-family: Arial, Helvetica, sans-serif; font-size:18px; font-weight:800; letter-spacing:4px; color:#ffffff;">PHANTOM&nbsp;TRACK</span>
                      {%- endif -%}
                    </a>
                  </td>
                  <td align="right" valign="middle" style="font-family: 'Courier New', Courier, monospace; font-size:13px; color:#9ca3af; letter-spacing:1px;">
                    {%- if order_name -%}ORDER {{ order_name }}{%- endif -%}
                    {%- if po_number -%}<br>PO #{{ po_number }}{%- endif -%}
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Hero -->
          <tr>
            <td style="padding: 0 0 16px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#0b0b0f" style="background:#0b0b0f; border:1px solid #1f1f27; border-radius:28px;">
                <tr>
                  <td class="px" style="padding: 40px 36px;">
                    <div style="font-family: 'Courier New', Courier, monospace; font-size:12px; letter-spacing:2px; color:#a855f7; text-transform:uppercase; margin-bottom:14px;">
                      Out for delivery
                    </div>
                    <div class="hero" style="font-family: Arial, Helvetica, sans-serif; font-size:48px; line-height:0.95; font-weight:800; letter-spacing:-1.5px; color:#ffffff;">
                      ARRIVING TODAY<span style="color:#a855f7;">.</span>
                    </div>
                    <div style="font-family: Arial, Helvetica, sans-serif; font-size:16px; line-height:1.6; color:#b4b4c0; margin:20px 0 0 0;">
                      {% if customer.first_name %}Hey {{ customer.first_name }}! {% endif %}Your gear is out for delivery and should arrive today.
                    </div>
{%- if custom_message != blank -%}
                    <div style="font-family: Arial, Helvetica, sans-serif; font-size:15px; line-height:1.6; color:#ffffff; margin:16px 0 0 0; padding:14px 18px; border-left:3px solid #a855f7; background:#15151c;">{{ custom_message }}</div>
{%- endif -%}
                    {%- if fulfillment.tracking_numbers.size > 0 -%}
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:22px; border:1px solid #26262f; border-radius:16px; background:#111111;" bgcolor="#111111">
                      <tr>
                        <td style="padding:16px 20px; font-family: Arial, Helvetica, sans-serif; font-size:14px; line-height:1.7; color:#d4d4dc;">
                          <div style="font-family: 'Courier New', Courier, monospace; font-size:11px; letter-spacing:2px; color:#a855f7; text-transform:uppercase; margin-bottom:8px;">{% if fulfillment.tracking_company %}{{ fulfillment.tracking_company }} {% endif %}Tracking</div>
                          {%- for tracking_number in fulfillment.tracking_numbers -%}
                            {%- assign tracking_link = fulfillment.tracking_urls[forloop.index0] -%}
                            {%- if tracking_link -%}
                              <a href="{{ tracking_link }}" style="font-family: 'Courier New', Courier, monospace; color:#ffffff; text-decoration:underline;">{{ tracking_number }}</a><br>
                            {%- else -%}
                              <span style="font-family: 'Courier New', Courier, monospace; color:#ffffff;">{{ tracking_number }}</span><br>
                            {%- endif -%}
                          {%- endfor -%}
                        </td>
                      </tr>
                    </table>
                    {%- endif -%}
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:28px;">
                      <tr>
{%- if fulfillment.tracking_url -%}
                        <td class="stack" style="padding-right:12px;">
                          <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td bgcolor="#ffffff" style="border-radius:999px;">
                                <a href="{{ fulfillment.tracking_url }}" style="display:inline-block; padding:15px 30px; font-family: Arial, Helvetica, sans-serif; font-size:14px; font-weight:800; letter-spacing:2px; color:#000000; text-decoration:none; border-radius:999px;">TRACK PACKAGE</a>
                              </td>
                            </tr>
                          </table>
                        </td>
{%- endif -%}
{%- if order_status_url -%}
                        <td class="stack" style="padding-right:12px;">
                          <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td style="border:1px solid #3a3a46; border-radius:999px;">
                                <a href="{{ order_status_url }}" style="display:inline-block; padding:14px 28px; font-family: Arial, Helvetica, sans-serif; font-size:14px; font-weight:800; letter-spacing:2px; color:#ffffff; text-decoration:none; border-radius:999px;">VIEW ORDER</a>
                              </td>
                            </tr>
                          </table>
                        </td>
{%- endif -%}
                      </tr>
                    </table>

                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- IN THIS SHIPMENT. -->
          <tr>
            <td style="padding: 0 0 16px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#111111" style="background:#111111; border:1px solid #1f1f27; border-radius:28px;">
                <tr>
                  <td class="px" style="padding: 32px 36px;">
                    <div style="font-family: Arial, Helvetica, sans-serif; font-size:20px; font-weight:800; color:#ffffff; letter-spacing:-0.3px; margin-bottom:20px;">IN THIS SHIPMENT.</div>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      {%- for line in fulfillment.fulfillment_line_items -%}
                        {%- assign item = line.line_item -%}
                        {%- unless item.nested_line_child? -%}
                        <tr>
                          <td width="72" valign="top" style="padding: 0 0 18px 0;">
                            {%- if item -%}
                              <img src="{{ item | img_url: 'compact_cropped' }}" alt="" width="60" height="60" style="display:block; width:60px; height:60px; border-radius:14px; border:1px solid #2a2a33; object-fit:cover;">
                            {%- else -%}
                              <div style="width:60px; height:60px; border-radius:14px; background:#1a1a22; border:1px solid #2a2a33;"></div>
                            {%- endif -%}
                          </td>
                          <td valign="top" style="padding: 2px 0 18px 4px; font-family: Arial, Helvetica, sans-serif;">
                            <div style="font-size:15px; font-weight:700; color:#ffffff; line-height:1.3;">{{ item.product.title | default: item.presentment_title | default: item.title }}</div>
                            {%- if item.variant.title != 'Default Title' and item.variant.title != blank -%}
                              <div style="font-size:13px; color:#9ca3af; margin-top:3px;">{{ item.variant.title }}</div>
                            {%- endif -%}
                            <div style="font-family: 'Courier New', Courier, monospace; font-size:13px; color:#9ca3af; margin-top:3px;">Qty {% if line.quantity < line.line_item.quantity %}{{ line.quantity }} of {{ line.line_item.quantity }}{% else %}{{ line.quantity }}{% endif %}</div>
                          </td>
                        </tr>
                        {%- endunless -%}
                      {%- endfor -%}
                    </table>

                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- SHIPPING TO. -->
          <tr>
            <td style="padding: 0 0 16px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#111111" style="background:#111111; border:1px solid #1f1f27; border-radius:28px;">
                <tr>
                  <td class="px" style="padding: 32px 36px;">
                    <div style="font-family: Arial, Helvetica, sans-serif; font-size:20px; font-weight:800; color:#ffffff; letter-spacing:-0.3px; margin-bottom:20px;">SHIPPING TO.</div>
                    {%- if shipping_address -%}
                    <div style="font-family: Arial, Helvetica, sans-serif; font-size:14px; line-height:1.6; color:#d4d4dc;">
                      <div style="font-family: 'Courier New', Courier, monospace; font-size:11px; letter-spacing:2px; color:#a855f7; text-transform:uppercase; margin-bottom:8px;">Ship to</div>
                      {{ shipping_address | format_address }}
                    </div>
                    {%- endif -%}

                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td class="px" align="center" style="padding: 24px 32px 8px 32px; font-family: Arial, Helvetica, sans-serif; font-size:13px; line-height:1.7; color:#6b6b78;">
              Questions? Reply to this email or reach us at
              <a href="mailto:{{ support_email }}" style="color:#a855f7; text-decoration:none;">{{ support_email }}</a>.
              <br><br>
              <a href="{{ site_url }}" style="color:#9ca3af; text-decoration:none;">phantom-track.com</a>
              &nbsp;&middot;&nbsp;
              <a href="{{ site_url }}/shipping" style="color:#9ca3af; text-decoration:none;">Shipping</a>
              &nbsp;&middot;&nbsp;
              <a href="{{ site_url }}/returns" style="color:#9ca3af; text-decoration:none;">Returns</a>
              &nbsp;&middot;&nbsp;
              <a href="{{ site_url }}/support" style="color:#9ca3af; text-decoration:none;">Support</a>
              <br><br>
              <span style="color:#4b4b56;">&copy; {{ 'now' | date: '%Y' }} Phantom Track LLC. Secure checkout &middot; 30-day returns &middot; Ships to US &amp; Canada</span>
              <!-- shopify-managed-taxes-footer -->
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
