{%- comment -%}
  Phantom Track — POS and mobile receipt
  Generated by shopify-email-templates/build.py. Edit there, not here.
{%- endcomment -%}
{%- assign site_url = 'https://phantom-track.com' -%}
{%- assign support_email = 'contact@phantom-track.com' -%}
{%- assign accent = '#a855f7' -%}

{%- assign total_order_discount_amount = 0 -%}
{%- for discount_application in discount_applications -%}
  {%- if discount_application.target_selection == 'all' and discount_application.target_type == 'line_item' -%}
    {%- assign total_order_discount_amount = total_order_discount_amount | plus: discount_application.total_allocated_amount -%}
  {%- endif -%}
{%- endfor -%}
{%- assign shipping_total = shipping_price -%}
{%- if shipping_methods.size > 0 -%}
  {%- assign shipping_total = 0 -%}
  {%- for method in shipping_methods -%}
    {%- assign shipping_total = shipping_total | plus: method.price_with_discounts -%}
  {%- endfor -%}
{%- endif -%}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <meta name="supported-color-schemes" content="dark">
  <title>Your Phantom Track receipt</title>
  <style>
    body { margin: 0; padding: 0; background: #050505; }
    a { color: #a855f7; }
    @media only screen and (max-width: 620px) {
      .container { width: 100% !important; }
      .px { padding-left: 20px !important; padding-right: 20px !important; }
      .stack { display: block !important; width: 100% !important; padding: 0 0 20px 0 !important; }
      .hero { font-size: 40px !important; }
    }
  </style>
</head>
<body style="margin:0; padding:0; background:#050505; -webkit-text-size-adjust:100%;">

  <div style="display:none; max-height:0; overflow:hidden; opacity:0; color:#050505;">
    Your receipt for Phantom Track order {{ order_name }}.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#050505" style="background:#050505;">
    <tr>
      <td align="center" style="padding: 32px 12px;">
        <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px; max-width:600px;">

          <!-- Header -->
          <tr>
            <td class="px" style="padding: 0 32px 28px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="left" valign="middle">
                    <a href="{{ site_url }}" style="text-decoration:none;">
                      {%- if shop.email_logo_url -%}
                        <img src="{{ shop.email_logo_url }}" alt="Phantom Track" width="{{ shop.email_logo_width | default: 160 }}" style="display:block; border:0; max-width:220px; height:auto;">
                      {%- else -%}
                        <span style="font-family: Arial, Helvetica, sans-serif; font-size:18px; font-weight:800; letter-spacing:4px; color:#ffffff;">PHANTOM&nbsp;TRACK</span>
                      {%- endif -%}
                    </a>
                  </td>
                  <td align="right" valign="middle" style="font-family: 'Courier New', Courier, monospace; font-size:13px; color:#9ca3af; letter-spacing:1px;">
                    {%- if order_name -%}ORDER {{ order_name }}{%- endif -%}
                    {%- if po_number -%}<br>PO #{{ po_number }}{%- endif -%}
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Hero -->
          <tr>
            <td style="padding: 0 0 16px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#0b0b0f" style="background:#0b0b0f; border:1px solid #1f1f27; border-radius:28px;">
                <tr>
                  <td class="px" style="padding: 40px 36px;">
                    <div style="font-family: 'Courier New', Courier, monospace; font-size:12px; letter-spacing:2px; color:#a855f7; text-transform:uppercase; margin-bottom:14px;">
                      &#10003;&nbsp; Receipt
                    </div>
                    <div class="hero" style="font-family: Arial, Helvetica, sans-serif; font-size:48px; line-height:0.95; font-weight:800; letter-spacing:-1.5px; color:#ffffff;">
                      THANKS FOR GEARING UP<span style="color:#a855f7;">.</span>
                    </div>
                    <div style="font-family: Arial, Helvetica, sans-serif; font-size:16px; line-height:1.6; color:#b4b4c0; margin:20px 0 0 0;">
                      {% if customer.first_name %}Hey {{ customer.first_name }}! {% endif %}Here's your receipt.
                    </div>
{%- if custom_message != blank -%}
                    <div style="font-family: Arial, Helvetica, sans-serif; font-size:15px; line-height:1.6; color:#ffffff; margin:16px 0 0 0; padding:14px 18px; border-left:3px solid #a855f7; background:#15151c;">{{ custom_message }}</div>
{%- endif -%}
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:28px;">
                      <tr>
{%- if order_status_url -%}
                        <td class="stack" style="padding-right:12px;">
                          <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td style="border:1px solid #3a3a46; border-radius:999px;">
                                <a href="{{ order_status_url }}" style="display:inline-block; padding:14px 28px; font-family: Arial, Helvetica, sans-serif; font-size:14px; font-weight:800; letter-spacing:2px; color:#ffffff; text-decoration:none; border-radius:999px;">VIEW ORDER</a>
                              </td>
                            </tr>
                          </table>
                        </td>
{%- endif -%}
                        <td class="stack" style="padding-right:12px;">
                          <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td style="border:1px solid #3a3a46; border-radius:999px;">
                                <a href="{{ site_url }}/products" style="display:inline-block; padding:14px 28px; font-family: Arial, Helvetica, sans-serif; font-size:14px; font-weight:800; letter-spacing:2px; color:#ffffff; text-decoration:none; border-radius:999px;">BROWSE MORE &rarr;</a>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>

                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- ORDER SUMMARY. -->
          <tr>
            <td style="padding: 0 0 16px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#111111" style="background:#111111; border:1px solid #1f1f27; border-radius:28px;">
                <tr>
                  <td class="px" style="padding: 32px 36px;">
                    <div style="font-family: Arial, Helvetica, sans-serif; font-size:20px; font-weight:800; color:#ffffff; letter-spacing:-0.3px; margin-bottom:20px;">ORDER SUMMARY.</div>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      {%- for line in subtotal_line_items -%}
                        {%- unless line.nested_line_child? -%}
                        {%- assign line_name = line.product.title | default: line.presentment_title | default: line.title -%}
                        <tr>
                          <td width="72" valign="top" style="padding: 0 0 18px 0;">
                            {%- if line -%}
                              <img src="{{ line | img_url: 'compact_cropped' }}" alt="" width="60" height="60" style="display:block; width:60px; height:60px; border-radius:14px; border:1px solid #2a2a33; object-fit:cover;">
                            {%- else -%}
                              <div style="width:60px; height:60px; border-radius:14px; background:#1a1a22; border:1px solid #2a2a33;"></div>
                            {%- endif -%}
                          </td>
                          <td valign="top" style="padding: 2px 12px 18px 4px; font-family: Arial, Helvetica, sans-serif;">
                            <div style="font-size:15px; font-weight:700; color:#ffffff; line-height:1.3;">{{ line_name }}</div>
                            {%- if line.variant.title != 'Default Title' and line.variant.title != blank -%}
                              <div style="font-size:13px; color:#9ca3af; margin-top:3px;">{{ line.variant.title }}</div>
                            {%- endif -%}
                            <div style="font-family: 'Courier New', Courier, monospace; font-size:13px; color:#9ca3af; margin-top:3px;">Qty {{ line.quantity }}</div>
                            {%- if line.selling_plan_allocation -%}
                              <div style="font-size:13px; color:#9ca3af; margin-top:3px;">{{ line.selling_plan_allocation.selling_plan.name }}</div>
                            {%- endif -%}
                            {%- for discount_allocation in line.discount_allocations -%}
                              {%- if discount_allocation.discount_application.target_selection != 'all' -%}
                                <div style="font-size:12px; color:#a855f7; margin-top:4px;">{{ discount_allocation.discount_application.title | upcase }} (&minus;{{ discount_allocation.amount | money }})</div>
                              {%- endif -%}
                            {%- endfor -%}
                            {%- if line.refunded_quantity > 0 -%}
                              <div style="font-size:12px; color:#f87171; margin-top:4px;">Refunded</div>
                            {%- endif -%}
                          </td>
                          <td valign="top" align="right" style="padding: 2px 0 18px 0; font-family: 'Courier New', Courier, monospace; font-size:15px; color:#ffffff; white-space:nowrap;">
                            {%- if line.original_line_price != line.final_line_price -%}
                              <div style="font-size:12px; color:#6b6b78; text-decoration:line-through;">{{ line.original_line_price | money }}</div>
                            {%- endif -%}
                            {%- if line.final_line_price > 0 -%}{{ line.final_line_price | money }}{%- else -%}Free{%- endif -%}
                          </td>
                        </tr>
                        {%- endunless -%}
                      {%- endfor -%}
                    </table>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #26262f; margin-top:4px;">
                      <tr><td colspan="2" style="height:10px; line-height:10px; font-size:0;">&nbsp;</td></tr>
                      <tr>
                        <td style="padding:6px 0; font-family: Arial, Helvetica, sans-serif; font-size:14px; color:#9ca3af;">Subtotal</td>
                        <td align="right" style="padding:6px 0; font-family: 'Courier New', Courier, monospace; font-size:14px; color:#ffffff;">{{ subtotal_price | plus: total_order_discount_amount | money }}</td>
                      </tr>
                      {%- for discount_application in discount_applications -%}
                        {%- if discount_application.target_selection == 'all' and discount_application.target_type == 'line_item' -%}
                      <tr>
                        <td style="padding:6px 0; font-family: Arial, Helvetica, sans-serif; font-size:14px; color:#a855f7;">Discount &middot; {{ discount_application.title }}</td>
                        <td align="right" style="padding:6px 0; font-family: 'Courier New', Courier, monospace; font-size:14px; color:#a855f7;">&minus;{{ discount_application.total_allocated_amount | money }}</td>
                      </tr>
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if fee_lines.size > 0 -%}
                      <tr>
                        <td style="padding:6px 0; font-family: Arial, Helvetica, sans-serif; font-size:14px; color:#9ca3af;">Fees</td>
                        <td align="right" style="padding:6px 0; font-family: 'Courier New', Courier, monospace; font-size:14px; color:#ffffff;">{{ total_fees | money }}</td>
                      </tr>
                      {%- endif -%}
                      {%- if requires_shipping -%}
                      <tr>
                        <td style="padding:6px 0; font-family: Arial, Helvetica, sans-serif; font-size:14px; color:#9ca3af;">Shipping</td>
                        <td align="right" style="padding:6px 0; font-family: 'Courier New', Courier, monospace; font-size:14px; color:#ffffff;">{%- if shipping_total == 0 -%}Free{%- else -%}{{ shipping_total | money }}{%- endif -%}</td>
                      </tr>
                      {%- endif -%}
                      {%- assign duties_total = current_total_duties | default: total_duties -%}
                      {%- if duties_total -%}
                      <tr>
                        <td style="padding:6px 0; font-family: Arial, Helvetica, sans-serif; font-size:14px; color:#9ca3af;">Duties</td>
                        <td align="right" style="padding:6px 0; font-family: 'Courier New', Courier, monospace; font-size:14px; color:#ffffff;">{{ duties_total | money }}</td>
                      </tr>
                      {%- endif -%}
                      <tr>
                        <td style="padding:6px 0; font-family: Arial, Helvetica, sans-serif; font-size:14px; color:#9ca3af;">Taxes</td>
                        <td align="right" style="padding:6px 0; font-family: 'Courier New', Courier, monospace; font-size:14px; color:#ffffff;">{{ tax_price | money }}</td>
                      </tr>
                      {%- if total_tip and total_tip > 0 -%}
                      <tr>
                        <td style="padding:6px 0; font-family: Arial, Helvetica, sans-serif; font-size:14px; color:#9ca3af;">Tip</td>
                        <td align="right" style="padding:6px 0; font-family: 'Courier New', Courier, monospace; font-size:14px; color:#ffffff;">{{ total_tip | money }}</td>
                      </tr>
                      {%- endif -%}
                      <tr>
                        <td style="padding:16px 0 0 0; border-top:1px solid #26262f; font-family: Arial, Helvetica, sans-serif; font-size:16px; font-weight:800; color:#ffffff;">Total</td>
                        <td align="right" style="padding:16px 0 0 0; border-top:1px solid #26262f; font-family: 'Courier New', Courier, monospace; font-size:22px; font-weight:700; color:#ffffff;">{{ total_price | money_with_currency }}</td>
                      </tr>
                      {%- if total_discounts > 0 -%}
                        <tr>
                          <td></td>
                          <td align="right" style="padding:6px 0 0 0; font-family: Arial, Helvetica, sans-serif; font-size:13px; color:#a855f7;">You saved {{ total_discounts | money }}</td>
                        </tr>
                      {%- endif -%}
                    </table>

                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- PAYMENT. -->
          <tr>
            <td style="padding: 0 0 16px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#111111" style="background:#111111; border:1px solid #1f1f27; border-radius:28px;">
                <tr>
                  <td class="px" style="padding: 32px 36px;">
                    <div style="font-family: Arial, Helvetica, sans-serif; font-size:20px; font-weight:800; color:#ffffff; letter-spacing:-0.3px; margin-bottom:20px;">PAYMENT.</div>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        {%- if shipping_address -%}
                        <td class="stack" width="50%" valign="top" style="padding: 0 16px 20px 0; font-family: Arial, Helvetica, sans-serif; font-size:14px; line-height:1.6; color:#d4d4dc;"><div style="font-family: 'Courier New', Courier, monospace; font-size:11px; letter-spacing:2px; color:#a855f7; text-transform:uppercase; margin-bottom:8px;">Ship to</div>
                          {{ shipping_address | format_address }}
                        </td>
                        {%- endif -%}
                      </tr>
                      <tr>
                        {%- if shipping_method or shipping_methods.size > 0 -%}
                        <td class="stack" width="50%" valign="top" style="padding: 0 16px 20px 0; font-family: Arial, Helvetica, sans-serif; font-size:14px; line-height:1.6; color:#d4d4dc;"><div style="font-family: 'Courier New', Courier, monospace; font-size:11px; letter-spacing:2px; color:#a855f7; text-transform:uppercase; margin-bottom:8px;">Shipping method</div>
                          {%- if shipping_methods.size > 0 -%}
                            {{ shipping_methods | map: 'title' | uniq | join: '<br>' }}
                          {%- else -%}
                            {{ shipping_method.title }}
                          {%- endif -%}
                        </td>
                        {%- endif -%}
                        <td class="stack" width="50%" valign="top" style="padding: 0 16px 20px 0; font-family: Arial, Helvetica, sans-serif; font-size:14px; line-height:1.6; color:#d4d4dc;"><div style="font-family: 'Courier New', Courier, monospace; font-size:11px; letter-spacing:2px; color:#a855f7; text-transform:uppercase; margin-bottom:8px;">Payment</div>
                          {%- assign shown_payment = false -%}
                          {%- for transaction in transactions -%}
                            {%- if transaction.status == 'success' or transaction.status == 'pending' -%}
                              {%- if transaction.kind == 'capture' or transaction.kind == 'sale' or transaction.kind == 'authorization' -%}
                                {%- if transaction.payment_details.credit_card_company and transaction.payment_details.credit_card_last_four_digits -%}
                                  {{ transaction.payment_details.credit_card_company }} ending in {{ transaction.payment_details.credit_card_last_four_digits }}<br>
                                {%- elsif transaction.payment_details.gift_card_last_four_digits -%}
                                  Gift card ending in {{ transaction.payment_details.gift_card_last_four_digits }}<br>
                                {%- else -%}
                                  {{ transaction.gateway_display_name }}<br>
                                {%- endif -%}
                                {%- assign shown_payment = true -%}
                              {%- endif -%}
                            {%- endif -%}
                          {%- endfor -%}
                          {%- unless shown_payment -%}{{ payment_terms.translated_name | default: '&mdash;' }}{%- endunless -%}
                        </td>
                      </tr>
                    </table>

                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td class="px" align="center" style="padding: 24px 32px 8px 32px; font-family: Arial, Helvetica, sans-serif; font-size:13px; line-height:1.7; color:#6b6b78;">
              Questions? Reply to this email or reach us at
              <a href="mailto:{{ support_email }}" style="color:#a855f7; text-decoration:none;">{{ support_email }}</a>.
              <br><br>
              <a href="{{ site_url }}" style="color:#9ca3af; text-decoration:none;">phantom-track.com</a>
              &nbsp;&middot;&nbsp;
              <a href="{{ site_url }}/shipping" style="color:#9ca3af; text-decoration:none;">Shipping</a>
              &nbsp;&middot;&nbsp;
              <a href="{{ site_url }}/returns" style="color:#9ca3af; text-decoration:none;">Returns</a>
              &nbsp;&middot;&nbsp;
              <a href="{{ site_url }}/support" style="color:#9ca3af; text-decoration:none;">Support</a>
              <br><br>
              <span style="color:#4b4b56;">&copy; {{ 'now' | date: '%Y' }} Phantom Track LLC. Secure checkout &middot; 30-day returns &middot; Ships to US &amp; Canada</span>
              <!-- shopify-managed-taxes-footer -->
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>

{%- if billing_address.country_code == 'DE' or billing_address.country_code == 'DK' -%}
  {%- if shop.terms_of_service.body != blank -%}
    {{ shop.terms_of_service | attach_as_pdf: "Terms of service" }}
  {%- endif -%}
  {%- if shop.refund_policy.body != blank -%}
    {{ shop.refund_policy | attach_as_pdf: "Refund policy" }}
  {%- endif -%}
{%- endif -%}
